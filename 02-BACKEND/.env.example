# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (Prisma) ---
DATABASE_URL=postgresql://priora:priora@localhost:5432/priora_mind?schema=public

# --- Auth / JWT (research D3) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- EmailPort (research D2) ---
# Adapter selection: "fake" (dev/test, in-memory capture) | "http" (production provider)
EMAIL_PROVIDER=fake
EMAIL_FROM=no-reply@priora.local
EMAIL_API_BASE_URL=
EMAIL_API_KEY=

# --- CORS / Frontend origin ---
CORS_ORIGIN=http://localhost:3001

# --- OpenTelemetry (optional, redacted — no sensitive content emitted) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=priora-mind-backend